<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>zip.zigi</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/limeburst/zigi-data/bin/zigi-zip</string>
        <string>serve</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/postgresql@18/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>ZIGI_CONFIG</key>
        <string>/Users/limeburst/zigi-data/config.toml</string>
        <key>RUST_LOG</key>
        <string>info,sqlx=warn</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/limeburst/zigi-data</string>

    <key>StandardOutPath</key>
    <string>/Users/limeburst/zigi-data/zigi.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/limeburst/zigi-data/zigi.err.log</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
