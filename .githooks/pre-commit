#!/usr/bin/env bash
# Mirrors the `cargo fmt --check` step in CI. Run through mise when available
# so the pinned toolchain's rustfmt does the check, as CI's does.
set -euo pipefail
if command -v mise >/dev/null 2>&1; then
    run=(mise exec -- cargo fmt --check)
else
    run=(cargo fmt --check)
fi
if ! "${run[@]}" >/dev/null; then
    echo "pre-commit: code is not formatted; run \`mise run fmt\` and stage the result" >&2
    exit 1
fi
